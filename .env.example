# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here has a working default that reaches a
# real service, so an unconfigured deployment fails loudly instead of quietly
# doing the wrong thing.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://shop.example.com
SESSION_SECRET=            # openssl rand -hex 32
SESSION_SECURE=true        # true whenever PUBLIC_URL is https

# Set to false for production. When false, /auth/demo returns 404 and the only
# way to get a session is a verified Azure AD id_token.
DEMO_MODE=false

# ---- Microsoft Entra ID (Azure AD) ----------------------------------------
# App registration -> Overview for the first two, Certificates & secrets for
# the third. Redirect URI must be exactly PUBLIC_URL + /auth/callback (Web).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUTHORITY=https://login.microsoftonline.com
AZURE_REDIRECT_PATH=/auth/callback
AZURE_SCOPES=openid profile email offline_access

# App role value in Azure AD -> role in this application.
AZURE_ROLE_MAP={"Shop.Admin":"admin","Shop.Sales":"sales","Shop.Customer":"customer"}
# Role for a user who signs in with no matching app role assigned.
AZURE_DEFAULT_ROLE=customer

# ---- Licensing -------------------------------------------------------------
LICENSE_ISSUER=https://licenses.example.com
LICENSE_TOKEN_TTL_DAYS=7      # how quickly a revocation reaches an online app
LICENSE_GRACE_DAYS=14         # how long past ends_at an offline app keeps running
LICENSE_KEY_DIR=/var/lib/cpq/keys      # private signing keys — back this up, 0700
DB_FILE=/var/lib/cpq/app.db
# Comma-separated API keys for the server-to-server license API (Api-Token header).
LICENSE_API_KEYS=

# ---- External license server (optional) ------------------------------------
# Leave LICENSE_SERVER_URL empty to use the built-in license server.
# Set it to bridge to a different one; the four operations are then HTTP calls.
LICENSE_SERVER_URL=
LICENSE_SERVER_TOKEN=
LICENSE_SERVER_AUTH_HEADER=Api-Token
LICENSE_SERVER_TIMEOUT_MS=20000
# Override the endpoint map if the target server uses different paths:
# LICENSE_SERVER_ENDPOINTS={"issue":"POST /v1/licenses","update":"PATCH /v1/licenses/{licenseId}","renew":"POST /v1/licenses/{licenseId}/renew","revoke":"POST /v1/licenses/{licenseId}/revoke"}

# ---- Payments --------------------------------------------------------------
PAYMENT_PROVIDER=stripe       # 'mock' for demo, 'stripe' for real money
CURRENCY=EUR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=        # from the Stripe CLI or dashboard webhook endpoint

# ---- Quoting ---------------------------------------------------------------
QUOTE_VALID_DAYS=30
QUOTE_APPROVAL_PCT=20         # discounts above this need sales approval
